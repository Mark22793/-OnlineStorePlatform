# Copy to .env (git-ignored) and change the values before the first `docker compose up`.
# Local development values only: never put real credentials in this file.
#
# SQL Server password rules: at least 8 characters with 3 of upper case, lower case, digit and symbol.
# Do not use the characters  $  '  ;  "  in these passwords (they break compose, T-SQL or connection strings).

ASPNETCORE_ENVIRONMENT=Development

# SQL Server: sa is used only by the one-shot sqlserver-init container
MSSQL_SA_PASSWORD=Sa#LocalDev2026

# One login per service; each can open only its own database
CATALOG_DB_PASSWORD=Catalog#Dev2026
INVENTORY_DB_PASSWORD=Inventory#Dev2026
ORDER_DB_PASSWORD=Order#Dev2026
PAYMENT_DB_PASSWORD=Payment#Dev2026
AUTH_DB_PASSWORD=Auth#Dev2026

# RabbitMQ (the default guest/guest is fine locally)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT: issued and validated by the gateway. At least 32 characters.
JWT_KEY=replace-with-a-random-string-of-at-least-32-chars
JWT_ISSUER=store-gateway
JWT_AUDIENCE=store-platform
JWT_EXPIRY_MINUTES=60

# Register/login attempts allowed per client per minute (gateway rate limit)
AUTH_RATE_LIMIT_PER_MINUTE=5

# Demo accounts seeded into AuthDb on startup (leave blank to skip)
SEED_ADMIN_EMAIL=admin@store.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_CUSTOMER_EMAIL=customer@store.local
SEED_CUSTOMER_PASSWORD=Customer12345
