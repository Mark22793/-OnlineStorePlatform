              "path": [
                "inventory",
                "v1",
                "stock"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"stock rows\", () => pm.expect(pm.response.json().length).to.be.at.least(10));"
                ]
              }
            }
          ]
        },
        {
