{
  "info": {
    "_postman_id": "4c6f9584-cce4-4177-8eab-b5b34bcaa633",
    "name": "Store Platform",
    "description": "Main flows through the API gateway. Select the 'Store Platform - local' environment, run `docker compose up`, then run the whole collection in order (Runner). Folders 5-7 exercise the order saga, including both compensation paths; folder 8 uses up the login quota for a minute, so it runs last.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Public browse (no token)",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalog/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "catalog",
                "v1",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"seeded products present\", () => pm.expect(list.length).to.be.at.least(10));",
                  "pm.environment.set(\"productId\", list[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/inventory/v1/stock",
