    {
      "name": "5 Saga: successful order",
      "item": [
        {
          "name": "Payment simulation -> None",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payment/v1/simulation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payment",
                "v1",
                "simulation"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"None\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Place order -> 202 Pending",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-order-ok"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"simulatePaymentFailure\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 202\", () => pm.response.to.have.status(202));",
                  "const o = pm.response.json();",
                  "pm.environment.set(\"okOrderId\", o.id);",
                  "pm.test(\"starts Pending\", () => pm.expect(o.status).to.eql(\"Pending\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Order is Confirmed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/v1/orders/{{okOrderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order",
                "v1",
                "orders",
                "{{okOrderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 6000); // give the saga time to finish over RabbitMQ"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const o = pm.response.json();",
                  "pm.test(\"order is Confirmed\", () => pm.expect(o.status).to.eql(\"Confirmed\"));",
                  "pm.test(\"history recorded\", () => pm.expect(o.statusHistory.length).to.be.above(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment is Charged",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
