    {
      "name": "8 Rate limit on login (run last)",
      "item": [
        {
          "name": "6th login within a minute -> 429",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "v1",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"wrong-password-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Burn the remaining quota (5 register/login calls per minute per client), then this request is rejected.",
                  "const send = (n) => {",
                  "  if (n === 0) return;",
                  "  pm.sendRequest({",
                  "    url: pm.environment.get(\"baseUrl\") + \"/auth/v1/login\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: { mode: \"raw\", raw: JSON.stringify({ email: \"x@example.com\", password: \"wrong-password-1\" }) }",
                  "  }, () => send(n - 1));",
                  "};",
                  "send(5);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 429\", () => pm.response.to.have.status(429));",
                  "pm.test(\"Retry-After present\", () => pm.expect(pm.response.headers.has(\"Retry-After\")).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    }
