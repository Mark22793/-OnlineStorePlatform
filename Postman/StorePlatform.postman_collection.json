    {
      "name": "4 Correlation ID",
      "item": [
        {
          "name": "Caller-supplied ID is echoed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "postman-trace-001"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/catalog/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "catalog",
                "v1",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"same id returned\", () => pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.eql(\"postman-trace-001\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway creates an ID when missing",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalog/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "catalog",
                "v1",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"id generated\", () => pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.match(/^[a-f0-9]{32}$/));"
                ]
              }
            }
          ]
        }
      ]
