{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Ocelot": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "store-gateway",
    "Audience": "store-platform",
    "ExpiryMinutes": 60
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 5
  },
  "Swagger": {
    "Enabled": false
  }
}
